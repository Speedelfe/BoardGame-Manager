<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BoardGameManager</RootNamespace>
    <WarnOn>3390;$(WarnOn)</WarnOn>
    <!-- NU1510: Paket listet auch Pakete auf, die .NET 10 schon mitbringt (z.B. System.Text.Json).
         Die eingebaute Version gewinnt automatisch, die Warnung ist daher harmlos. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Core/Types.fs"/>
    <Compile Include="Core/GameFunctions.fs"/>
    <Compile Include="Core/Functions.fs"/>
    <Compile Include="View/MainView.fs"/>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <Import Project="..\.paket\Paket.Restore.targets" />
</Project>
